@{
    ViewBag.Title = "Home";
}

<div class="home-hero">
    <h1>Free <span>PDF Tools</span><br/>That Just Work</h1>
    <p>Merge, compress, protect, create, extract, and stamp your PDFs. No sign-up, no watermarks, no nonsense.</p>
    <a href="@Url.Action("Index", "PdfUtils")" class="btn-primary">Get Started</a>
</div>

<div class="tools-grid">
    <a href="@Url.Action("Index", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 3h-8l-2 4h12z"/></svg>
        </div>
        <div>
            <h3>Stitch / Merge</h3>
            <p>Combine two PDF files into a single document</p>
        </div>
    </a>
    <a href="@Url.Action("Compress", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
        </div>
        <div>
            <h3>Compress</h3>
            <p>Reduce file size while maintaining quality</p>
        </div>
    </a>
    <a href="@Url.Action("Protect", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
            <h3>Password Protect</h3>
            <p>Add reading and editing passwords to your PDFs</p>
        </div>
    </a>
    <a href="@Url.Action("Make", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div>
            <h3>Make a PDF</h3>
            <p>Type content in a rich editor and export as PDF</p>
        </div>
    </a>
    <a href="@Url.Action("Extract", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
        </div>
        <div>
            <h3>Extract Text</h3>
            <p>Pull plain text content out of PDF files</p>
        </div>
    </a>
    <a href="@Url.Action("Stamp", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
            <h3>Stamp &amp; Verify</h3>
            <p>Add a QR code for document authenticity verification</p>
        </div>
    </a>
    <a href="@Url.Action("Initial", "PdfUtils")" class="tool-card">
        <div class="tool-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
        </div>
        <div>
            <h3>Initial Pages</h3>
            <p>Stamp your initials onto every page of a PDF</p>
        </div>
    </a>
</div>
