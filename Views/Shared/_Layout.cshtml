<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - PDF Tools</title>
    <link rel="stylesheet" href="~/Content/Site.css" />
</head>
<body>
    <header class="site-navbar">
        <div class="container">
            <a href="@Url.Action("Index", "Home")" class="brand">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                PDF Tools
            </a>
            <nav>
                <a href="@Url.Action("Index", "Home")">Home</a>
                <a href="@Url.Action("Index", "PdfUtils")" class="active">PDF Utils</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <script>
    document.querySelectorAll('.file-upload').forEach(function(zone) {
        var input = zone.querySelector('input[type="file"]');
        var text = zone.querySelector('.file-upload-text');
        if (!input || !text) return;
        input.addEventListener('change', function() {
            if (input.files.length > 0) {
                var names = Array.from(input.files).map(function(f) { return f.name; });
                text.innerHTML = '<strong>' + names.length + ' file' + (names.length > 1 ? 's' : '') + '</strong> selected';
                zone.style.borderColor = 'var(--primary)';
                zone.style.background = 'var(--primary-light)';
            }
        });
        zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.style.borderColor = 'var(--primary)'; zone.style.background = 'var(--primary-light)'; });
        zone.addEventListener('dragleave', function() { zone.style.borderColor = ''; zone.style.background = ''; });
        zone.addEventListener('drop', function() { zone.style.borderColor = ''; zone.style.background = ''; });
    });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
